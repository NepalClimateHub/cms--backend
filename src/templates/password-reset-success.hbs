<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Your password was changed - Nepal Climate Hub</title>
  <style>
    @media only screen and (max-width: 560px) {
      .px { padding-left: 24px !important; padding-right: 24px !important; }
      .btn-cell, .btn-link { display: block !important; width: 100% !important; box-sizing: border-box !important; }
      .h1 { font-size: 26px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#eef3ec;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#17231b;-webkit-text-size-adjust:100%;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#eef3ec;">Your password was updated and other devices were signed out.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#eef3ec;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background-color:#fbfdfa;border-radius:16px;overflow:hidden;border:1px solid #d9e4d6;">

          <tr>
            <td class="px" style="background-color:#14391f;padding:28px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="width:34px;height:34px;background-color:#4ade80;border-radius:10px;text-align:center;font-size:18px;line-height:34px;font-weight:800;color:#14391f;">N</td>
                  <td style="padding-left:12px;font-size:17px;font-weight:700;letter-spacing:0.2px;color:#f1f8ef;">Nepal Climate Hub</td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td class="px" style="padding:40px 40px 8px 40px;">
              <div style="width:48px;height:48px;border-radius:24px;background-color:#dcebd8;color:#15803d;font-size:26px;font-weight:800;line-height:48px;text-align:center;margin:0 0 20px 0;">&#10003;</div>
              <p style="margin:0 0 14px 0;font-size:13px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#2f7a45;">Account security</p>
              <h1 class="h1" style="margin:0 0 16px 0;font-size:30px;line-height:1.15;font-weight:800;color:#0f2917;">Password updated, {{fullName}}</h1>
              <p style="margin:0;font-size:16px;line-height:1.6;color:#3b4a40;">You can sign in with your new password now. We signed you out of your other devices to keep your account safe.</p>
            </td>
          </tr>

          <tr>
            <td class="px" style="padding:28px 40px 8px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td class="btn-cell" align="center" bgcolor="#15803d" style="border-radius:12px;background-color:#15803d;">
                    <!--[if mso]>
                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="{{loginLink}}" style="height:54px;v-text-anchor:middle;width:480px;" arcsize="22%" stroke="f" fillcolor="#15803d">
                      <w:anchorlock/>
                      <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">Sign in</center>
                    </v:roundrect>
                    <![endif]-->
                    <!--[if !mso]><!-- -->
                    <a class="btn-link" href="{{loginLink}}" style="display:inline-block;padding:17px 40px;font-size:16px;font-weight:700;line-height:20px;color:#ffffff !important;text-decoration:none;border-radius:12px;"><span style="color:#ffffff;">Sign in &rarr;</span></a>
                    <!--<![endif]-->
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td class="px" style="padding:32px 40px 36px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#fdf6e9;border:1px solid #f0dcb4;border-radius:12px;">
                <tr>
                  <td style="padding:16px 18px;font-size:14px;line-height:1.55;color:#5c4a1e;"><strong style="color:#3d2f0e;">Wasn't you?</strong> Reset your password again right away from the sign-in page, then contact us.</td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
        <p style="margin:18px 0 0 0;font-size:12px;color:#7a8a7f;">&copy; {{currentYear}} Nepal Climate Hub</p>
      </td>
    </tr>
  </table>
</body>
</html>

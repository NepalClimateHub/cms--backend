generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String         @id @default(cuid())
  fullName                        String
  email                           String         @unique @db.VarChar(254)
  password                        String
  isEmailVerified                 Boolean        @default(false)
  profession                      String?
  expertise                       String?
  bio                             String?
  dateOfBirth                     DateTime?      @db.Timestamptz(6)
  dateOfJoin                      DateTime?      @db.Timestamptz(6)
  gender                          String?
  phoneCountryCode                String?
  phoneNumber                     String?
  addressId                       String?
  resetPasswordToken              String?
  resetPasswordExpires            DateTime?
  accountVerificationToken        String?
  accountVerificationTokenExpires DateTime?
  createdAt                       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime       @updatedAt
  deletedAt                       DateTime?
  socials                         Json?
  userType                        UserType       @default(INDIVIDUAL)
  profilePhotoId                  String?
  profilePhotoUrl                 String?
  currentRole                     String?
  bannerImageId                   String?
  bannerImageUrl                  String?
  /// Platform admin has verified this account (organization-linked users)
  isVerifiedByAdmin               Boolean        @default(false)
  i_am                            String         @default("Student")
  organizationId                  String?        @unique
  blogs                           Blog[]
  address                         Address?       @relation(fields: [addressId], references: [id])
  gallery                         Gallery[]      @relation("GalleryToUser")
  tags                            Tags[]         @relation("TagsToUser")
  organization                    Organizations? @relation("UserOrganizationLink", fields: [organizationId], references: [id], onDelete: SetNull)
  notifications                   Notification[]

  @@index([email])
}

enum NotificationType {
  BLOG_APPROVED
  BLOG_REJECTED
  ORGANIZATION_VERIFIED
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String?
  read       Boolean          @default(false)
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Organizations {
  id                         String    @id @default(cuid())
  name                       String
  description                String
  /// e.g. NGO, network, private sector — public-facing category label
  organizationType           String?
  addressId                  String?
  createdAt                  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?
  verificationDocumentUrl    String?
  verificationDocumentId     String?
  verificationRequestRemarks String?
  verificationRequestedAt    DateTime? @db.Timestamptz(6)
  address                    Address?  @relation(fields: [addressId], references: [id])
  organizationGallery        Gallery[] @relation("GalleryToOrganizations")
  tags                       Tags[]    @relation("OrganizationsToTags")
  linkedAccountUser          User?     @relation("UserOrganizationLink")
}

model Events {
  id                   String        @id @default(cuid())
  title                String
  description          String
  location             String?
  type                 String
  format               String
  startDate            DateTime?
  registrationDeadline DateTime?
  registrationLink     String?
  contactEmail         String?
  cost                 String?
  addressId            String?
  socialsId            String?
  bannerImageId        String?
  bannerImageUrl       String?
  contributedBy        String
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  locationType         String
  organizer            String        @map("organizer")
  isDraft              Boolean       @default(true)
  moderationStatus     ContentStatus @default(DRAFT)
  status               String        @default("OPEN")
  reviewFeedback       String?
  website              String?
  socials              Json?
  address              Address?      @relation(fields: [addressId], references: [id])
  eventGallery         Gallery[]     @relation("EventsToGallery")
  tags                 Tags[]        @relation("EventsToTags")
}

model Opportunity {
  id                  String        @id @default(cuid())
  title               String
  description         String
  location            String
  type                String
  format              String
  applicationDeadline DateTime?
  duration            String?
  contactEmail        String?
  cost                String?
  addressId           String?
  bannerImageId       String?
  bannerImageUrl      String?
  contributedBy       String
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
  locationType        String
  organizer           String        @map("organizer")
  isDraft             Boolean       @default(true)
  moderationStatus    ContentStatus @default(DRAFT)
  status              String        @default("open")
  reviewFeedback      String?
  websiteUrl          String?
  socials             Json?
  address             Address?      @relation(fields: [addressId], references: [id])
  tags                Tags[]        @relation("OpportunityToTags")
}

model News {
  id             String        @id @default(cuid())
  title          String
  source         String
  publishedDate  DateTime
  publishedYear  DateTime
  newsLink       String
  contributedBy  String
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  mode           String
  isDraft        Boolean       @default(true)
  status         ContentStatus @default(DRAFT)
  reviewFeedback String?
  tags           Tags[]        @relation("NewsToTags")
}

model Blog {
  id              String        @id @default(cuid())
  title           String
  content         String
  excerpt         String?
  author          String
  category        String
  readingTime     String?
  publishedDate   DateTime?
  isDraft         Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  bannerImageUrl  String?
  bannerImageId   String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  approvedByAdmin Boolean       @default(false)
  authorId        String?
  status          ContentStatus @default(DRAFT)
  reviewFeedback  String?
  isTopRead       Boolean       @default(false)
  categoryId      String?
  authorUser      User?         @relation(fields: [authorId], references: [id])
  categoryData    Category?     @relation(fields: [categoryId], references: [id])
  tags            Tags[]        @relation("BlogToTags")
}

model Address {
  id           String          @id @default(cuid())
  street       String?
  country      String?
  city         String?
  state        String?
  postcode     String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  event        Events[]
  opportunity  Opportunity[]
  organization Organizations[]
  user         User[]
}

model Tags {
  id                String          @id @default(cuid())
  tag               String
  isUserTag         Boolean         @default(false)
  isOrganizationTag Boolean         @default(false)
  isEventTag        Boolean         @default(false)
  isNewsTag         Boolean         @default(false)
  isOpportunityTag  Boolean         @default(false)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  isBlogTag         Boolean         @default(false)
  isProjectTag      Boolean         @default(false)
  isResourceTag     Boolean         @default(false)
  blog              Blog[]          @relation("BlogToTags")
  event             Events[]        @relation("EventsToTags")
  news              News[]          @relation("NewsToTags")
  opportunity       Opportunity[]   @relation("OpportunityToTags")
  organization      Organizations[] @relation("OrganizationsToTags")
  project           Project[]       @relation("ProjectToTags")
  resources         Resource[]      @relation("ResourceToTags")
  user              User[]          @relation("TagsToUser")
}

model Resource {
  id              String         @id @default(cuid())
  title           String
  overview        String?
  type            ResourceType
  level           ResourceLevel?
  link            String?
  courseProvider  String?
  platform        String?
  duration        String?
  author          String?
  publicationYear String?
  bannerImageUrl  String?
  bannerImageId   String?
  isDraft         Boolean        @default(true)
  status          ContentStatus  @default(DRAFT)
  reviewFeedback  String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  tags            Tags[]         @relation("ResourceToTags")
}

model Gallery {
  id           String          @id @default(cuid())
  sourceId     String?
  publicUrl    String
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  events       Events[]        @relation("EventsToGallery")
  organization Organizations[] @relation("GalleryToOrganizations")
  user         User[]          @relation("GalleryToUser")
}

model SubscribedEmailUser {
  id        String    @id @default(cuid())
  email     String    @unique @db.VarChar(254)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime?
}

model Project {
  id             String        @id @default(cuid())
  title          String
  duration       String?
  overview       String
  description    String
  status         ProjectStatus @default(ONGOING)
  bannerImageUrl String?
  bannerImageId  String?
  isDraft        Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  tags           Tags[]        @relation("ProjectToTags")
}

model answers {
  id         String      @id @db.Uuid
  query_id   String      @db.Uuid
  model      String      @db.VarChar(80)
  answer_en  String
  answer_ne  String?
  raw        Json?
  tokens_in  Int
  tokens_out Int
  latency_ms Int
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  queries    queries     @relation(fields: [query_id], references: [id], onDelete: Cascade)
  citations  citations[]

  @@index([query_id])
}

model chat_messages {
  id            String        @id @db.Uuid
  session_id    String        @db.Uuid
  role          String        @db.VarChar(50)
  content       String
  sources       Json?
  metadata      Json?
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  chat_sessions chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
}

model ai_assistant_settings {
  id                       Int                 @id @default(1)
  visual_responses_enabled Boolean             @default(false)
  climate_data_enabled     Boolean             @default(false)
  climate_maps_enabled     Boolean             @default(false)
  graph_rag_enabled        Boolean             @default(false)
  climate_rollout_stage    ClimateRolloutStage @default(DISABLED)
  updated_at               DateTime            @updatedAt @db.Timestamptz(6)
  updated_by               String?             @db.VarChar(255)
}

model climate_datasets {
  id             String                         @id @default(cuid())
  code           String                         @unique @db.VarChar(64)
  name           String                         @db.VarChar(200)
  provider       String                         @db.VarChar(120)
  source_url     String
  temporal_grain String                         @default("month") @db.VarChar(20)
  last_synced_at DateTime?                      @db.Timestamptz(6)
  created_at     DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                       @updatedAt @db.Timestamptz(6)
  observations   climate_monthly_observations[]
  manifests      climate_source_manifests[]

  @@index([provider])
}

model climate_stations {
  id           String                         @id @db.VarChar(32)
  name         String                         @db.VarChar(200)
  country_code String                         @db.VarChar(3)
  country_name String                         @db.VarChar(100)
  latitude     Float
  longitude    Float
  elevation_m  Float?
  active       Boolean                        @default(true)
  metadata     Json                           @default("{}")
  created_at   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                       @updatedAt @db.Timestamptz(6)
  observations climate_monthly_observations[]
  normals      climate_normals[]

  @@index([country_code])
  @@index([latitude, longitude])
}

model climate_indicators {
  code         String                         @id @db.VarChar(24)
  name         String                         @db.VarChar(120)
  unit         String                         @db.VarChar(24)
  aggregation  String                         @db.VarChar(40)
  description  String?
  created_at   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                       @updatedAt @db.Timestamptz(6)
  observations climate_monthly_observations[]
  normals      climate_normals[]
}

model climate_monthly_observations {
  id             String                  @id @default(cuid())
  dataset_id     String
  station_id     String                  @db.VarChar(32)
  indicator_code String                  @db.VarChar(24)
  period         DateTime                @db.Date
  value          Float
  unit           String                  @db.VarChar(24)
  days_missing   Int?
  quality_flag   String?                 @db.VarChar(40)
  attributes     Json                    @default("{}")
  source_run_id  String?                 @db.Uuid
  created_at     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                @updatedAt @db.Timestamptz(6)
  dataset        climate_datasets        @relation(fields: [dataset_id], references: [id], onDelete: Restrict)
  station        climate_stations        @relation(fields: [station_id], references: [id], onDelete: Cascade)
  indicator      climate_indicators      @relation(fields: [indicator_code], references: [code], onDelete: Restrict)
  source_run     climate_ingestion_runs? @relation(fields: [source_run_id], references: [id], onDelete: SetNull)

  @@unique([dataset_id, station_id, indicator_code, period])
  @@index([station_id, indicator_code, period])
  @@index([indicator_code, period])
  @@index([source_run_id])
}

model climate_normals {
  id             String             @id @default(cuid())
  station_id     String             @db.VarChar(32)
  indicator_code String             @db.VarChar(24)
  calendar_month Int
  baseline_start Int                @default(1991)
  baseline_end   Int                @default(2020)
  value          Float
  valid_years    Int
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  updated_at     DateTime           @updatedAt @db.Timestamptz(6)
  station        climate_stations   @relation(fields: [station_id], references: [id], onDelete: Cascade)
  indicator      climate_indicators @relation(fields: [indicator_code], references: [code], onDelete: Cascade)

  @@unique([station_id, indicator_code, calendar_month, baseline_start, baseline_end])
  @@index([indicator_code, calendar_month])
}

model climate_ingestion_runs {
  id             String                         @id @db.Uuid
  mode           ClimateIngestionMode
  status         ClimateIngestionStatus         @default(QUEUED)
  stage          String                         @default("queued") @db.VarChar(80)
  requested_by   String?                        @db.VarChar(255)
  started_at     DateTime?                      @db.Timestamptz(6)
  heartbeat_at   DateTime?                      @db.Timestamptz(6)
  completed_at   DateTime?                      @db.Timestamptz(6)
  rows_processed Int                            @default(0)
  station_count  Int                            @default(0)
  batch_count    Int                            @default(0)
  failed_batches Int                            @default(0)
  error          String?
  metadata       Json                           @default("{}")
  created_at     DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                       @updatedAt @db.Timestamptz(6)
  observations   climate_monthly_observations[]
  manifests      climate_source_manifests[]

  @@index([status, created_at])
}

model climate_source_manifests {
  id             String                 @id @default(cuid())
  run_id         String                 @db.Uuid
  dataset_id     String
  checksum       String                 @db.VarChar(64)
  archive_path   String
  request_url    String
  response_bytes Int
  row_count      Int
  created_at     DateTime               @default(now()) @db.Timestamptz(6)
  run            climate_ingestion_runs @relation(fields: [run_id], references: [id], onDelete: Cascade)
  dataset        climate_datasets       @relation(fields: [dataset_id], references: [id], onDelete: Restrict)

  @@unique([run_id, checksum])
  @@index([checksum])
  @@index([dataset_id, created_at])
}

model climate_ontology_versions {
  id            String                           @id @default(cuid())
  version       Int                              @unique
  checksum      String                           @db.VarChar(64)
  active        Boolean                          @default(false)
  notes         String?
  created_at    DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                         @updatedAt @db.Timestamptz(6)
  concepts      climate_ontology_concepts[]
  aliases       climate_ontology_aliases[]
  relationships climate_ontology_relationships[]

  @@index([active])
}

model climate_ontology_concepts {
  id                     String                           @id @default(cuid())
  version_id             String
  key                    String                           @db.VarChar(160)
  type                   ClimateOntologyConceptType
  canonical_name         String                           @db.VarChar(200)
  description            String?
  external_ref           String?                          @db.VarChar(200)
  metadata               Json                             @default("{}")
  created_at             DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                         @updatedAt @db.Timestamptz(6)
  version                climate_ontology_versions        @relation(fields: [version_id], references: [id], onDelete: Cascade)
  aliases                climate_ontology_aliases[]
  outgoing_relationships climate_ontology_relationships[] @relation("ClimateOntologySource")
  incoming_relationships climate_ontology_relationships[] @relation("ClimateOntologyTarget")

  @@unique([version_id, key])
  @@index([version_id, type])
  @@index([external_ref])
}

model climate_ontology_aliases {
  id               String                    @id @default(cuid())
  version_id       String
  concept_id       String
  alias            String                    @db.VarChar(200)
  normalized_alias String                    @db.VarChar(200)
  language         String                    @default("en") @db.VarChar(12)
  created_at       DateTime                  @default(now()) @db.Timestamptz(6)
  version          climate_ontology_versions @relation(fields: [version_id], references: [id], onDelete: Cascade)
  concept          climate_ontology_concepts @relation(fields: [concept_id], references: [id], onDelete: Cascade)

  @@unique([version_id, normalized_alias, language])
  @@index([concept_id])
}

model climate_ontology_relationships {
  id         String                    @id @default(cuid())
  version_id String
  source_id  String
  predicate  String                    @db.VarChar(80)
  target_id  String
  metadata   Json                      @default("{}")
  created_at DateTime                  @default(now()) @db.Timestamptz(6)
  version    climate_ontology_versions @relation(fields: [version_id], references: [id], onDelete: Cascade)
  source     climate_ontology_concepts @relation("ClimateOntologySource", fields: [source_id], references: [id], onDelete: Cascade)
  target     climate_ontology_concepts @relation("ClimateOntologyTarget", fields: [target_id], references: [id], onDelete: Cascade)

  @@unique([version_id, source_id, predicate, target_id])
  @@index([version_id, predicate])
  @@index([target_id])
}

model climate_query_audits {
  id            String   @id @default(cuid())
  request_hash  String   @db.VarChar(64)
  route         String   @default("climate_data") @db.VarChar(32)
  query_plan    Json
  cache_hit     Boolean  @default(false)
  success       Boolean
  duration_ms   Int
  result_count  Int      @default(0)
  station_count Int      @default(0)
  visual_type   String?  @db.VarChar(40)
  error         String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([route, success, created_at])
  @@index([request_hash, created_at])
}

model chat_sessions {
  id            String          @id @db.Uuid
  user_id       String          @db.VarChar(255)
  title         String?         @db.VarChar(255)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @db.Timestamptz(6)
  chat_messages chat_messages[]

  @@index([user_id])
}

model chunks {
  id             String           @id @db.Uuid
  document_id    String           @db.Uuid
  version        Int              @default(1)
  chunk_index    Int
  faiss_id       String?          @unique @db.VarChar(20)
  page_start     Int?
  page_end       Int?
  text           String
  vector         Json
  meta           Json             @default("{}")
  collection     String           @default("main") @db.VarChar(64)
  embed_model    String           @default("intfloat/multilingual-e5-base") @db.VarChar(120)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @updatedAt @db.Timestamptz(6)
  documents      documents        @relation(fields: [document_id], references: [id], onDelete: Cascade)
  citations      citations[]
  retrieval_hits retrieval_hits[]

  @@unique([document_id, version, chunk_index])
  @@index([collection])
  @@index([document_id])
}

model citations {
  id        String  @id @db.Uuid
  answer_id String  @db.Uuid
  chunk_id  String  @db.Uuid
  title     String  @db.VarChar(300)
  page      String? @db.VarChar(40)
  url       String?
  answers   answers @relation(fields: [answer_id], references: [id], onDelete: Cascade)
  chunks    chunks  @relation(fields: [chunk_id], references: [id], onDelete: Cascade)

  @@index([answer_id])
}

model documents {
  id                String           @id @db.Uuid
  title             String           @db.VarChar(300)
  original_filename String?          @db.VarChar(500)
  storage_name      String?          @unique @db.VarChar(255)
  source_url        String?
  checksum          String?          @unique @db.VarChar(64)
  file_size         Int?
  total_pages       Int?
  media_type        String           @default("application/pdf") @db.VarChar(80)
  status            AiDocumentStatus @default(READY)
  active_version    Int              @default(1)
  chunk_count       Int              @default(0)
  index_error       String?
  uploaded_by       String?          @db.VarChar(255)
  indexed_at        DateTime?        @db.Timestamptz(6)
  deleted_at        DateTime?        @db.Timestamptz(6)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @updatedAt @db.Timestamptz(6)
  chunks            chunks[]
  index_jobs        ai_index_jobs[]

  @@index([title])
  @@index([status])
  @@index([deleted_at])
}

model ai_index_jobs {
  id           String           @id @db.Uuid
  document_id  String?          @db.Uuid
  operation    AiIndexOperation
  status       AiIndexJobStatus @default(QUEUED)
  stage        String           @default("queued") @db.VarChar(80)
  attempt      Int              @default(1)
  error        String?
  heartbeat_at DateTime?        @db.Timestamptz(6)
  started_at   DateTime?        @db.Timestamptz(6)
  completed_at DateTime?        @db.Timestamptz(6)
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  updated_at   DateTime         @updatedAt @db.Timestamptz(6)
  document     documents?       @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([document_id, status])
  @@index([status, heartbeat_at])
}

model queries {
  id           String       @id @db.Uuid
  user_id      String?      @db.Uuid
  text         String
  language     String?      @db.VarChar(10)
  routed_model String       @db.VarChar(80)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  answers      answers[]
  retrievals   retrievals[]

  @@index([user_id])
}

model retrieval_hits {
  id           String     @id @db.Uuid
  retrieval_id String     @db.Uuid
  rank         Int
  chunk_id     String     @db.Uuid
  score        Float
  chunks       chunks     @relation(fields: [chunk_id], references: [id], onDelete: Cascade)
  retrievals   retrievals @relation(fields: [retrieval_id], references: [id], onDelete: Cascade)

  @@index([chunk_id])
  @@index([retrieval_id])
}

model retrievals {
  id             String           @id @db.Uuid
  query_id       String           @db.Uuid
  top_k          Int              @default(10)
  filters        Json             @default("{}")
  latency_ms     Int
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  retrieval_hits retrieval_hits[]
  queries        queries          @relation(fields: [query_id], references: [id], onDelete: Cascade)

  @@index([query_id])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        CategoryType
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  blogs       Blog[]
}

enum ResourceType {
  DOCUMENTARY
  PODCASTS_AND_TELEVISION
  COURSES
  PLANS_AND_POLICIES
  DATA_RESOURCES
  PLATFORMS
  RESEARCH_ARTICLES
  THESES_AND_DISSERTATIONS
  CASE_STUDIES
  REPORTS
  TOOLKITS_AND_GUIDES
}

enum ResourceLevel {
  INTERNATIONAL
  REGIONAL
  NATIONAL
  PROVINCIAL
  LOCAL
}

enum UserType {
  SUPER_ADMIN
  ADMIN
  CONTENT_ADMIN
  ORGANIZATION
  INDIVIDUAL
}

enum AiDocumentStatus {
  UPLOADED
  QUEUED
  INDEXING
  READY
  FAILED
  DELETE_QUEUED
  DELETING
  DELETE_CLEANUP_FAILED
  DELETED
}

enum AiIndexOperation {
  ADD
  REINDEX
  DELETE
  FULL_REBUILD
  IMPORT
}

enum AiIndexJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ClimateIngestionMode {
  BACKFILL
  INCREMENTAL
}

enum ClimateIngestionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ClimateOntologyConceptType {
  LOCATION
  STATION
  DATASET
  INDICATOR
  SECTOR
  POLICY
  TARGET
  UNIT
  TERM
}

enum ClimateRolloutStage {
  DISABLED
  ADMIN
  INTERNAL
  LIMITED
  ALL
}

enum ContentStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  REJECTED
  IMPROVEMENT_REQUIRED
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

enum CategoryType {
  BLOG
  NEWS
  EVENTS
  OPPORTUNITY
  PROJECT
  RESOURCE
  ORGANIZATION
}

enum ActivityAction {
  LOGIN
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
}

enum ActivityEntity {
  AUTH
  BLOG
  EVENT
  NEWS
  OPPORTUNITY
  PROJECT
  RESOURCE
  MEMBER
  CLIMATE_CHAMPION
  TESTIMONIAL
  USER
  ORGANIZATION
  VACANCY
}

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String
  userEmail  String
  userName   String
  userRole   String
  action     ActivityAction
  entity     ActivityEntity
  entityId   String?
  entityName String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("activity_logs")
}

model NchMembers {
  id               String    @id @default(cuid())
  name             String
  email            String
  currentAddress   String?
  permanentAddress String?
  phoneNumber      String?
  linkedinProfile  String?
  photoUrl         String?
  photoId          String?
  bio              String?
  role             String
  startDate        DateTime? @db.Timestamptz(6)
  endDate          DateTime? @db.Timestamptz(6)
  isActive         Boolean   @default(true)
  team             String
  status           String
  order            Int       @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt

  @@map("nch_members")
}

model ClimateChampion {
  id        String   @id @default(cuid())
  name      String
  email     String?
  location  String?
  bio       String?  @db.Text
  photoUrl  String?
  photoId   String?
  tags      String[]
  website   String?
  facebook  String?
  instagram String?
  linkedin  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt

  @@map("nch_climate_champions")
}

model Minutes {
  id             String    @id @default(cuid())
  title          String
  date           DateTime?
  meetingTime    String?
  agenda         String    @db.Text
  meetingSummary String    @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@map("nch_minutes")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  photoUrl    String?
  photoId     String?
  description String   @db.Text
  stars       Int      @default(5)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt

  @@map("nch_testimonials")
}
model Vacancy {
  id               String               @id @default(cuid())
  title            String
  openings         Int                  @default(1)
  duration         String?
  hoursPerWeek     String?
  overview         String?              @db.Text
  responsibilities String[]             @default([])
  requirements     String[]             @default([])
  location         String?
  type             String?
  deadline         DateTime?            @db.Timestamptz(6)
  isActive         Boolean              @default(true)
  isDraft          Boolean              @default(false)
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  applications     VacancyApplication[]

  @@map("nch_vacancies")
}

model VacancyApplication {
  id             String   @id @default(cuid())
  vacancyId      String
  vacancy        Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  fullName       String
  email          String
  contact        String
  currentAddress String?
  message        String?  @db.Text
  cvUrl          String
  cvFileId       String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt

  @@index([vacancyId])
  @@map("nch_vacancy_applications")
}

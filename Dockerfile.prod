FROM node:24.2.0-bookworm-slim AS builder

WORKDIR /usr/src/app
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm prisma generate
RUN pnpm run build

FROM node:24.2.0-bookworm-slim

WORKDIR /usr/src/app
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
COPY --from=builder /usr/src/app/package.json /usr/src/app/pnpm-lock.yaml /usr/src/app/pnpm-workspace.yaml /usr/src/app/.npmrc ./
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/prisma ./prisma
ARG APP_ENV=production
RUN pnpm i --prod --frozen-lockfile

CMD ["sh", "-c", "pnpm --version && pnpm exec prisma generate && pnpm exec prisma migrate deploy && node dist/src/main"]

# Expects `pnpm build` to have run on the host/CI first: only dist + prod deps go into the image.
FROM node:24.2.0-bookworm-slim

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 COREPACK_ENABLE_AUTO_PIN=0
WORKDIR /usr/src/app
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY prisma ./prisma
# generate the client at build time so the image works even if the start command skips it
RUN pnpm i --prod --frozen-lockfile && pnpm exec prisma generate
COPY dist ./dist
ARG APP_ENV=production

CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/src/main"]
